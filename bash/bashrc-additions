# Add user-installed commands such as dev, fd, tree-sitter, and Starship.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Use the user-local en_US.UTF-8 locale when the WSL image does not provide it.
if [ -d "$HOME/.local/share/locale" ]; then
  export LOCPATH="$HOME/.local/share/locale${LOCPATH:+:$LOCPATH}"
fi

# Load NVM when installed.
export NVM_DIR="$HOME/.nvm"

if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
fi

if [ -s "$NVM_DIR/bash_completion" ]; then
  . "$NVM_DIR/bash_completion"
fi

# Enable the Starship prompt when installed.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Prompt for the database password only when starting Harlequin.
db() {
  local db_password
  local harlequin_python

  harlequin_python="$(dirname "$(readlink -f "$(command -v harlequin)")")/python"

  if ! IFS= read -r -s -p "team1db password: " db_password; then
    printf '\n'
    unset db_password
    return 130
  fi
  printf '\n'

  PGHOST="csce-315-db.engr.tamu.edu" \
  PGPORT="5432" \
  PGDATABASE="team1db" \
  PGUSER="team1" \
  PGPASSWORD="$db_password" \
  "$harlequin_python" "$HOME/projects/dotfiles/harlequin/launch.py"

  unset db_password
}
